# Copy to .env on production server (used by docker-compose.prod.yml + PM2 + Prisma)

# App
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://permatrax.tech

# JWT (openssl rand -base64 32)
JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARS_SECRET_HERE
JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_32_CHARS_SECRET_HERE

# Database (Docker Compose postgres service)
POSTGRES_USER=permatrax
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=permatrack
DATABASE_URL=postgresql://permatrax:CHANGE_ME_STRONG_PASSWORD@localhost:5432/permatrack?schema=public

# Redis (Docker Compose redis service)
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379

# File storage (local — not S3)
UPLOAD_DIR=./uploads
FILE_BASE_URL=https://api.permatrax.tech/api/files
MAX_FILE_SIZE=52428800

# SMTP (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@permatrax.com
SMTP_PASS=your_app_password_here

# Certbot
CERTBOT_EMAIL=admin@permatrax.tech

# Next.js (build-time)
NEXT_PUBLIC_API_URL=https://api.permatrax.tech/api
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token_here
