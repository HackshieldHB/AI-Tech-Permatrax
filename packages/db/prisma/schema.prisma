  name         String    @unique
  code         String    @unique
  contactEmail String?
  logoUrl      String?
  isActive     Boolean   @default(true)
  createdBy    String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  creator      User      @relation("IspCustomerCreator", fields: [createdBy], references: [id])
  pipelineTemplates PipelineTemplate[]
}

// NEW: CLEAN LIST STATUS ENUM
enum CleanListStatus {
  AVAILABLE
  IN_PROGRESS
  HAS_EXISTING_FIBER
  COMPLETED
  REJECTED
}

// NEW: CLEAN LIST — ISP cluster data imported by GM
model CleanList {
  id                String          @id @default(cuid())
  ispCustomer       String
  fiberType         FiberType
  rwCode            String
  kelurahan         String
  kecamatan         String
  kotaKabupaten     String
  homepasCount      Int             @default(0)
  hasExistingFiber  Boolean         @default(false)
  existingOperator  String?
  existingMarkedAt  DateTime?
  status            CleanListStatus @default(AVAILABLE)
  importedBy        String
  importedAt        DateTime        @default(now())
  siteName          String?
  projectType       String?
  permitStatus      String?
  implStatus        String?
  picPermit         String?
  actualHP          Int?
  hpHldApproved     Int?
  coordinates       String?
  lastUpdate        DateTime?
  remark            String?
  sourceSheet       String?
  externalCode      String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  importer          User            @relation("CleanListImporter", fields: [importedBy], references: [id])
  visitRequests     VisitRequest[]
  ftttProjects      FtttProject[]   @relation("FtttProjectCleanList")

  @@index([ispCustomer])
  @@index([fiberType])
  @@index([status])
  @@index([rwCode, kelurahan])
}

// NEW: VISIT REQUEST STATUS ENUM — dual PM gates (visit schedule vs survey result)
enum VisitRequestStatus {
  DRAFT
  PM_REVIEW_VISIT
  APPROVED_PENDING_DATA
  PM_REVIEW_SURVEY
  PM_SENIOR_REVIEW
  ADMIN_REVIEW
  APPROVED
  REJECTED
  EXISTING_FIBER
}

// NEW: STAKEHOLDER RESPONSE ENUM
enum StakeholderResponse {
  PENDING
  ALLOWED
  NOT_ALLOWED
  CONDITIONAL
}

// NEW: VISIT REQUEST — Surveyor requests field visit
model VisitRequest {
  id                    String              @id @default(cuid())
  cleanListId           String
  requestedBy           String
  assignedPmId          String?
  fiberType             FiberType
  ispCustomer           String

  rtContact             String?
  rwContact             String?
  pengelolaContact      String?
  areaCondition         String?
  existingNetworkFound  Boolean             @default(false)
  existingOperator      String?
  stakeholderResponse   StakeholderResponse? // optional until survey data step
  surveyNotes           String?
  visitDate             DateTime?
  evidencePhotos        String[]

  visitGateApprovedAt   DateTime?
  visitGateApprovedBy   String?

  status                VisitRequestStatus  @default(DRAFT)
  pmReviewedAt          DateTime?
  pmReviewedBy          String?
  pmSeniorApprovedAt    DateTime?
  pmSeniorApprovedBy    String?
  adminApprovedAt       DateTime?
  adminApprovedBy       String?
  rejectionReason       String?

  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  cleanList             CleanList           @relation(fields: [cleanListId], references: [id])
  requester             User                @relation("VisitRequester", fields: [requestedBy], references: [id])
  assignedPm            User?               @relation("VisitPM", fields: [assignedPmId], references: [id])
  baOpen                BaOpen?
  approvalLogs          VisitApprovalLog[]
  permitCluster         PermitCluster?

  @@index([status])
  @@index([fiberType])
  @@index([requestedBy])
}

// NEW: BA OPEN STATUS ENUM
enum BaOpenStatus {
  GENERATED
  SENT
  ARCHIVED
}

// NEW: BA OPEN — auto-generated after visit approved
model BaOpen {
  id                 String        @id @default(cuid())
  visitRequestId     String        @unique
  documentNumber     String        @unique
  generatedAt        DateTime      @default(now())
  generatedBy        String
  pdfUrl             String?
  status             BaOpenStatus  @default(GENERATED)

  clusterName        String
  rwCode             String
  kelurahan          String
  ispCustomer        String
  visitDate          DateTime
  surveyorName       String
  rtRwName           String?
  areaDescription    String?
  stakeholderSummary String?
  tanggal            DateTime? // NEW: date of meeting/kunjungan
  tempat             String? // NEW: meeting location
  topik              String? // NEW: BA topic / Berita Acara subject
  description        String? // NEW: issues/description

  /// Area survey menemukan jaringan existing — tetap generate BA Open + cluster (Issue #46)
