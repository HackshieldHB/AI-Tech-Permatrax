enum AbdStatus {
  DRAFT
  SUBMITTED_TO_ISP
  ISP_REVISION_REQUIRED
  ISP_APPROVED
}

model AbdRevision {
  id        String   @id @default(cuid())
  abdId     String
  version   Int
  notes     String
  fileUrl   String?
  createdBy String
  createdAt DateTime @default(now())

  abd     Abd  @relation(fields: [abdId], references: [id], onDelete: Cascade)
  creator User @relation("AbdRevisionCreator", fields: [createdBy], references: [id])
}

model TechnicalDiagram {
  id         String               @id @default(cuid())
  abdId      String
  type       TechnicalDiagramType
  fileUrl    String
  version    Int                  @default(1)
  uploadedBy String
  createdAt  DateTime             @default(now())

  abd      Abd  @relation(fields: [abdId], references: [id], onDelete: Cascade)
  uploader User @relation("DiagramUploader", fields: [uploadedBy], references: [id])
}

enum TechnicalDiagramType {
  FLOW_DIAGRAM
  CORE_CONNECTION_DIAGRAM
}

model Socialization {
  id                  String                   @id @default(cuid())
  permitClusterId     String                   @unique
  conductedBy         String
  conductedAt       DateTime
  location            String
  attendees           Json
  constructionScope   String?
  affectedRoutes      String?
  plannedSchedule     String?
  communityFeedback   String?
  agreementStatus     SocializationAgreement     @default(PENDING)
  baSurveyNumber      String?                  @unique
  baSurveyPdfUrl      String?
  momNumber           String?                  @unique
  momPdfUrl           String?
  generatedAt         DateTime?
  evidencePhotos      String[]
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  permitCluster PermitCluster @relation(fields: [permitClusterId], references: [id])
  conductor     User          @relation("SocializationConductor", fields: [conductedBy], references: [id])
}

enum SocializationAgreement {
  PENDING
  AGREED
  CONDITIONAL
  REJECTED
}

model Compensation {
  id               String                @id @default(cuid())
  permitClusterId  String                @unique
  homepasCount     Int
  scheme           CompensationScheme    @default(PER_HOMEPASS)
  proposedAmount   Decimal               @db.Decimal(15, 2)
  negotiatedAmount Decimal?              @db.Decimal(15, 2)
  finalAmount      Decimal?              @db.Decimal(15, 2)
  currency         String                @default("IDR")
  agreementStatus  CompensationAgreement @default(PENDING)
  notes            String?
  createdBy        String
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  permitCluster PermitCluster  @relation(fields: [permitClusterId], references: [id])
  creator       User           @relation("CompensationCreator", fields: [createdBy], references: [id])
  negotiations  NegotiationLog[]
  bak           Bak?
}

enum CompensationScheme {
  PER_HOMEPASS
  LUMP_SUM
}

enum CompensationAgreement {
  PENDING
  AGREED
  REJECTED
}

model NegotiationLog {
  id              String   @id @default(cuid())
  compensationId  String
  roundNumber     Int
  proposedAmount  Decimal  @db.Decimal(15, 2)
  rtResponse      String
  notes           String?
  recordedBy      String
  createdAt       DateTime @default(now())

  compensation Compensation @relation(fields: [compensationId], references: [id], onDelete: Cascade)
  recorder     User         @relation("NegotiationRecorder", fields: [recordedBy], references: [id])
}

model Bak {
  id               String    @id @default(cuid())
  permitClusterId  String    @unique
  compensationId   String    @unique
  documentNumber   String    @unique
  finalAmount      Decimal   @db.Decimal(15, 2)
  recipientName    String
  recipientBank    String
  recipientAccount String
  status           BakStatus @default(DRAFT)
  autoApproved     Boolean   @default(false)
  approvedBy       String?
  approvedAt       DateTime?
  rejectionReason  String?
  pdfUrl           String?
  generatedAt      DateTime?
  createdBy        String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

