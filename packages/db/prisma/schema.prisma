// NEW: StockLogType enum
enum StockLogType {
  IN_PURCHASE   // Barang masuk dari pembelian
  IN_ORDER      // Barang masuk dari verifikasi order (barang diterima / SESUAI)
  IN_RETURN     // Barang dikembalikan
  OUT_ORDER     // Barang keluar untuk order proyek
  OUT_DAMAGED   // Barang rusak/disposal
  ADJUSTMENT    // Koreksi stok manual oleh admin
}

// NEW: STOCK ITEM — master item catalog
model StockItem {
  id            String    @id @default(cuid())
  name          String
  code          String    @unique
  category      String
  unit          String
  mitra         String
  currentQty    Int       @default(0)
  minStockQty   Int       @default(0)
  description   String?
  isActive      Boolean   @default(true)
  createdBy     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  creator       User        @relation("StockItemCreator", fields: [createdBy], references: [id])
  orderItems    OrderItem[]
  stockLogs     StockLog[]

  @@index([name])
  @@index([category])
  @@index([code])
  @@index([mitra])
}

// NEW: STOCK LOG — every quantity change recorded
model StockLog {
  id            String       @id @default(cuid())
  stockItemId   String
  type          StockLogType
  qtyBefore     Int
  qtyChange     Int
  qtyAfter      Int
  reference     String?
  notes         String?
  actorId       String
  createdAt     DateTime     @default(now())

  stockItem     StockItem    @relation(fields: [stockItemId], references: [id])
  actor         User         @relation("StockLogActor", fields: [actorId], references: [id])

  @@index([stockItemId])
  @@index([type])
  @@index([createdAt])
}

// Phase 3 — procurement enums (unified Order flow)
enum OrderTrigger {
  PROJECT_REQUEST
  STOCK_RESTOCK
}

enum PaymentMethod {
  CBD
  COD
  TERMIN
}

enum SupplierInvoiceStatus {
  DRAFT
  SENT_TO_SUPPLIER
  APPROVED_BY_SUPPLIER
  REJECTED_BY_SUPPLIER
}

enum StockOutStatus {
  DRAFT              // returned to PM for revision
  PENDING            // submitted, waiting Admin Stock
  PENDING_PM_CONFIRM // Admin Stock approved with DO#, waiting PM confirmation
  PENDING_FINANCE    // PM confirmed, waiting Finance approval
  FULFILLED          // Finance approved, Surat Jalan generated
  REJECTED           // hard-cancelled (legacy / manual override)
}

// FIX: OrderStatus — alur stok katalog (Surat Jalan) + alur approval pembelian (satu model Order)
enum OrderStatus {
  DRAFT
  SUBMITTED
  STOCK_AVAILABLE
  PARTIAL_STOCK
  NO_STOCK
  PENDING_ADMIN_STOCK
  PENDING_PURCHASING_INPUT
  PENDING_OPS_APPROVAL
  REJECTED_BY_OPS
  PENDING_GM_APPROVAL
  REJECTED_BY_GM
  PENDING_PAYMENT_RECEIPT
  PENDING_FINANCE
  PURCHASED
  PENDING_VERIFICATION
  FULFILLED
  CANCELLED
  PROCESSING // FIX: reserved / legacy compatibility
  COMPLETED // FIX: reserved / legacy compatibility
}

// NEW: ORDER — PM requests materials for a project (Phase 3: STOCK_RESTOCK + procurement)
model Order {
  id                String    @id @default(cuid())
  orderNumber       String    @unique
  createdBy         String
  fiberType         FiberType
  projectRef        String?
  notes             String?
  status            OrderStatus @default(DRAFT)
  suratJalanId      String?   @unique
  purchaseRequestId String?   @unique

  orderTrigger      OrderTrigger @default(PROJECT_REQUEST)

  requestedItems         Json?
  purchaseItems          Json?
  totalAmount            Decimal?  @default(0) @db.Decimal(15, 2)
  adminStockNotes        String?
  opsNotes               String?
  gmNotes                String?
  financeNotes           String?
  submittedByAdminAt     DateTime?
  opsApprovedAt          DateTime?
  gmApprovedAt           DateTime?
  financeProcessedAt     DateTime?
  itemsArrivedAt         DateTime?
  fulfilledAt            DateTime?
  adminStockSubmittedBy  String?
  opsApprovedBy          String?
  gmApprovedBy           String?
  financeProcessedBy     String?
  verifiedBy             String?
  verificationNotes      String?
  verificationStatus     String?
  financeReceiptUrl      String?

  opsRejectionReason     String? // FIX: Ops tolak → revisi Admin Stok
  gmRejectionReason      String? // FIX: GM tolak → revisi Admin Stok
  revisionCount          Int       @default(0) // FIX: jumlah siklus revisi

  supplierId               String?
  supplier                 Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  purchasingSubmittedById String?
  purchasingSubmittedAt DateTime?
  purchasingNotes         String?
  purchasingSubmittedBy   User?    @relation("OrderPurchasingSubmittedBy", fields: [purchasingSubmittedById], references: [id], onDelete: SetNull)

  poNumber          String?   @unique
  poGeneratedAt     DateTime?
  poFileUrl         String?
  poEmailSentAt     DateTime?
  poEmailSentById   String?
  poEmailMessageId  String?
  poEmailSentBy     User?     @relation("OrderPoEmailSentBy", fields: [poEmailSentById], references: [id], onDelete: SetNull)

  ppnType           String?   // 'PERCENT' | 'NOMINAL'
  ppnValue          Decimal?  @db.Decimal(15, 2)

  cancelledById    String?
  cancelledAt      DateTime?
  cancelReason     String?
  cancelledBy      User?     @relation("OrderCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)

  financeProjectId String?
  financeProject   FinanceProject? @relation(fields: [financeProjectId], references: [id], onDelete: SetNull)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  creator           User             @relation("OrderCreator", fields: [createdBy], references: [id])
  items             OrderItem[]
  suratJalan        SuratJalan?      @relation("OrderSuratJalan", fields: [suratJalanId], references: [id])
  purchaseRequest   PurchaseRequest? @relation("OrderPurchaseRequest", fields: [purchaseRequestId], references: [id])
  supplierInvoice   SupplierInvoice?

  @@index([status])
  @@index([createdBy])
  @@index([orderNumber])
  @@index([financeProjectId])
  @@index([orderTrigger])
  @@index([supplierId])
  @@index([status, orderTrigger])
}

// NEW: ORDER ITEM — line items in an order
model OrderItem {
  id            String    @id @default(cuid())
  orderId       String
  stockItemId   String?
  itemName      String
  itemCode      String?
  category      String?
  unit          String
  requestedQty  Int
  availableQty  Int       @default(0)
  fulfilledQty  Int       @default(0)
  unitPrice     Decimal?  @db.Decimal(15, 2)
  totalPrice    Decimal?  @db.Decimal(15, 2)

  order         Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stockItem     StockItem? @relation(fields: [stockItemId], references: [id])

  @@index([orderId])
}

model Supplier {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  npwp            String?
  email           String?
  phone           String?
  address         String?
  bankAccount     String?
  bankName        String?
  contactPerson   String?
  notes           String?
  isActive        Boolean  @default(true)
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdBy        User               @relation("SupplierCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  orders           Order[]
  supplierInvoices SupplierInvoice[]

  @@index([isActive])
  @@index([code])
}

model SupplierInvoice {
  id                      String                @id @default(cuid())
  invoiceNumber           String                @unique
  orderId                 String                @unique
  supplierId              String

  invoiceFileUrl          String?
  invoiceAmount           Decimal               @db.Decimal(18, 2)

  paymentMethod           PaymentMethod
  paymentDueDate          DateTime?

  status                  SupplierInvoiceStatus @default(DRAFT)
  emailSentAt             DateTime?
  supplierAckAt           DateTime?
  supplierRejectionReason String?

  uploadedById String
  approvedById String?
  approvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  uploadedBy User     @relation("SupplierInvoiceUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  approvedBy User?    @relation("SupplierInvoiceApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([supplierId])
}

model StockOut {
  id              String         @id @default(cuid())
  requestNumber   String         @unique
  requestedById   String
  permitClusterId String?
  items           Json
  status          StockOutStatus @default(PENDING)
  recipient         String?        // Up./Penerima — siapa yang menerima barang
  recipientCompany  String?        // Nama perusahaan tujuan pengiriman
  recipientAddress  String?        // Alamat pengiriman
  recipientTelp     String?        // Nomor telepon tujuan

  // Admin Stock approval step
  doNumber              String?
  adminStockApprovedById String?
  adminStockApprovedAt   DateTime?

  // PM confirmation step
  pmConfirmedById String?
  pmConfirmedAt   DateTime?

  // Finance approval step
  financeApprovedById String?
  financeApprovedAt   DateTime?

  // Shared
  revisionNotes   String?        // reason when sent back for revision
  notes           String?
  suratJalanId    String?  @unique

  // Legacy fields kept for backward compatibility with old PENDING→FULFILLED flow
  fulfilledById   String?
  fulfilledAt     DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requestedBy        User            @relation("StockOutRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  fulfilledBy        User?           @relation("StockOutFulfilledBy", fields: [fulfilledById], references: [id], onDelete: SetNull)
  adminStockApprover User?           @relation("StockOutAdminApprover", fields: [adminStockApprovedById], references: [id], onDelete: SetNull)
  pmConfirmer        User?           @relation("StockOutPMConfirmer", fields: [pmConfirmedById], references: [id], onDelete: SetNull)
  financeApprover    User?           @relation("StockOutFinanceApprover", fields: [financeApprovedById], references: [id], onDelete: SetNull)
  permitCluster      PermitCluster?  @relation(fields: [permitClusterId], references: [id], onDelete: SetNull)
  suratJalan         SuratJalan?     @relation("StockOutSuratJalan", fields: [suratJalanId], references: [id], onDelete: SetNull)

  @@index([status, requestedById])
  @@index([status])
}

// NEW: SuratJalanType enum
enum SuratJalanType {
  OUT
  IN
}

// NEW: SuratJalanStatus enum
enum SuratJalanStatus {
  GENERATED
  DISPATCHED
  CONFIRMED
  CANCELLED
}

// NEW: SURAT JALAN — delivery/dispatch document
model SuratJalan {
  id             String           @id @default(cuid())
  documentNumber String           @unique
  type           SuratJalanType
  generatedBy    String
  confirmedBy    String?
  confirmedAt    DateTime?
  pdfUrl         String?
  status         SuratJalanStatus @default(GENERATED)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  generator      User             @relation("SuratJalanGenerator", fields: [generatedBy], references: [id])
  confirmer      User?            @relation("SuratJalanConfirmer", fields: [confirmedBy], references: [id])
  order          Order?           @relation("OrderSuratJalan")
  stockOut       StockOut?        @relation("StockOutSuratJalan")

  @@index([type])
  @@index([status])
  @@index([documentNumber])
}

// NEW: PurchaseRequestStatus enum
enum PurchaseRequestStatus {
  PENDING
  IN_REVIEW
  APPROVED
  ORDERED
  RECEIVED
  REJECTED
  CANCELLED
}

// NEW: PURCHASE REQUEST — sent to Finance when stock insufficient
model PurchaseRequest {
  id              String                @id @default(cuid())
  requestNumber   String                @unique
  requestedBy     String
  processedBy     String?
  totalAmount     Decimal?              @db.Decimal(15, 2)
  currency        String                @default("IDR")
  status          PurchaseRequestStatus @default(PENDING)
  financeNotes    String?
  approvedAt      DateTime?
  processedAt     DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  requester       User                  @relation("PRRequester", fields: [requestedBy], references: [id])
  processor       User?                 @relation("PRProcessor", fields: [processedBy], references: [id])
  order           Order?                @relation("OrderPurchaseRequest")
  items           PurchaseRequestItem[]

  @@index([status])
  @@index([requestedBy])
}

// NEW: PURCHASE REQUEST ITEM — line items
model PurchaseRequestItem {
  id                String   @id @default(cuid())
  purchaseRequestId String
  itemName          String
  itemCode          String?
  category          String?
  unit              String
  requestedQty      Int
  unitPrice         Decimal? @db.Decimal(15, 2)
  totalPrice        Decimal? @db.Decimal(15, 2)
  supplierNote      String?

  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)

  @@index([purchaseRequestId])
}

// ═══════════════════════════════════════════════════════════════════════════
// NEW: PHASE 5 — Full permit document flow (APD → … → Construction Ready)
// ═══════════════════════════════════════════════════════════════════════════

model PermitCluster {
  id                     String              @id @default(cuid())
  visitRequestId         String              @unique
  baOpenId               String?             @unique
  clusterCode            String
  ispCustomer            String
  fiberType              FiberType
  assignedPmId           String
  currentPhase           PermitPhase         @default(CLUSTER_INTAKE)
  status                 PermitClusterStatus @default(IN_PROGRESS)
  readyForConstructionAt DateTime?
  latitude               Float?
  longitude              Float?
  rwName                 String?
  areaCategory           String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  visitRequest VisitRequest @relation(fields: [visitRequestId], references: [id])
  baOpen       BaOpen?      @relation(fields: [baOpenId], references: [id])
  assignedPm   User         @relation("PermitPM", fields: [assignedPmId], references: [id])

  apd           Apd?
  socialization Socialization?
  compensation  Compensation?
  bak           Bak?
  bakAgreement  BakAgreement?
  scom          Scom?
  bakp          Bakp?

  // NEW: lifecycle v2 relations
  surveyData        SurveyData?
  surveyorDocPackage SurveyorDocPackage?
  sip               Sip?
  hld               Hld?
  lld               Lld?
  prBrRecords       PrBrRecord[]
  contracts         ContractRecord[]
  prBrWorkflow      PrBrWorkflow?
  skomBudget        SkomBudget?
  claimPackage      ClaimPackage?
  invoicePackage    InvoicePackage?
  stockOuts         StockOut[]

  // NEW: Phase 3A — Pipeline Template Engine
  pipelineTemplateId   String?
  pipelineTemplate     PipelineTemplate?     @relation(fields: [pipelineTemplateId], references: [id])
  stageProgresses      ClusterStageProgress[]
  documentUploads      StageDocumentUpload[]
  smileProgresses      SmileProgress[]
  jaminans             Jaminan[]
  amandemen            Amandemen[]
  mcvClaims            McvClaim[]
  bastTimer            BastTimer?

  @@index([status])
  @@index([fiberType])
  @@index([currentPhase])
  @@index([status, createdAt])
  @@index([pipelineTemplateId])
}

model PipelineTemplate {
  id            String          @id @default(cuid())
  name          String
  fiberType     FiberType
  ispCustomerId String
  ispCustomer   IspCustomer     @relation(fields: [ispCustomerId], references: [id])
  isActive      Boolean         @default(true)
  version       Int             @default(1)
  stages        PipelineStage[]
  clusters      PermitCluster[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([fiberType, ispCustomerId, version])
}

model PipelineStage {
  id                String                  @id @default(cuid())
  templateId        String
  template          PipelineTemplate        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  sequence          Int
  name              String
  shortLabel        String
  color             String?
  triggerConditions Json?
  autoAdvance       Boolean                 @default(false)
  notifyRoles       String[]
  allowedActorRoles String[]
  requiredDocuments StageDocument[]
  progresses        ClusterStageProgress[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@unique([templateId, sequence])
}

model StageDocument {
  id          String                @id @default(cuid())
  stageId     String
  stage       PipelineStage         @relation(fields: [stageId], references: [id], onDelete: Cascade)
  name        String
  description String?
  formats     String[]
  isRequired  Boolean               @default(true)
  uploads     StageDocumentUpload[]
}

model ClusterStageProgress {
  id            String              @id @default(cuid())
  clusterId     String
  cluster       PermitCluster       @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  stageId       String
  stage         PipelineStage       @relation(fields: [stageId], references: [id])
  status        StageProgressStatus @default(LOCKED)
  unlockedAt    DateTime?
  completedAt   DateTime?
  completedById String?             // User ID reference
  notes         String?
  metricValue   Decimal?            @db.Decimal(5, 2)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([clusterId, stageId])
}

model StageDocumentUpload {
  id              String        @id @default(cuid())
  stageDocumentId String
  stageDocument   StageDocument @relation(fields: [stageDocumentId], references: [id])
  clusterId       String
  cluster         PermitCluster @relation(fields: [clusterId], references: [id])
  fileUrl         String
  fileName        String
  uploadedById    String        // User ID reference
  uploadedAt      DateTime      @default(now())
}

model SmileProgress {
  id          String        @id @default(cuid())
  clusterId   String
  cluster     PermitCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  progressPct Decimal       @db.Decimal(5, 2)
  evidenceUrl String?
  recordedById String       // User ID reference
  recordedAt  DateTime      @default(now())
}

model Jaminan {
  id          String        @id @default(cuid())
  clusterId   String
  cluster     PermitCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  type        JaminanType
  amount      Decimal       @db.Decimal(15, 2)
  issuedAt    DateTime?
  expiresAt   DateTime?
  documentUrl String?
  createdById String        // User ID reference
  createdAt   DateTime      @default(now())
}

model Amandemen {
  id          String        @id @default(cuid())
  clusterId   String
  cluster     PermitCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  version     Int
  title       String
  description String?
  documentUrl String?
  signedAt    DateTime?
  createdById String        // User ID reference
  createdAt   DateTime      @default(now())

  @@unique([clusterId, version])
}

model McvClaim {
  id          String        @id @default(cuid())
  clusterId   String
  cluster     PermitCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  termNumber  Int
  amount      Decimal       @db.Decimal(15, 2)
  status      McvStatus     @default(DRAFT)
  documents   McvDocument[]
  submittedAt DateTime?
  approvedAt  DateTime?
  createdAt   DateTime      @default(now())

  @@unique([clusterId, termNumber])
}

model McvDocument {
  id         String   @id @default(cuid())
  mcvId      String
  mcv        McvClaim @relation(fields: [mcvId], references: [id], onDelete: Cascade)
  name       String
  fileUrl    String
  uploadedAt DateTime @default(now())
}

model BastTimer {
  id              String        @id @default(cuid())
  clusterId       String        @unique
  cluster         PermitCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  bast1IssuedAt   DateTime?
  bast2EligibleAt DateTime?
  bast2IssuedAt   DateTime?
  bast2Locked     Boolean       @default(true)
}

enum StageProgressStatus {
  LOCKED
  ACTIVE
  DONE
  BLOCKED
  SKIPPED
}

enum JaminanType {
  UANG_MUKA
  PELAKSANAAN
  PEMELIHARAAN
}

enum McvStatus {
  DRAFT
  SUBMITTED
  MCV_REVIEW
  APPROVED
  REJECTED
}


enum PermitPhase {
  CLUSTER_INTAKE
  VISIT_REQUEST
  BA_OPEN
  SITE_VISIT
  SURVEY_INPUT
  ROUTE_SURVEY
  BA_SURVEY
  SIP_REQUEST
  HLD_SUBMISSION
  LLD_SUBMISSION
  PR_BR_ISSUANCE
  CONTRACT_MANAGEMENT
  SKOM_BUDGET
  MANAGEMENT_APPROVAL
  FUND_DISBURSEMENT
  BAK_GENERATION
  BAKP_COMPILATION
  CLAIM_SUBMISSION
  INVOICE_PACKAGE
  PERMIT_DONE
}

enum PermitClusterStatus {
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

model Apd {
  id              String    @id @default(cuid())
  permitClusterId String    @unique
  createdBy       String
  version         Int       @default(1)
  status          ApdStatus @default(DRAFT)
  gisRouteData    Json?
  notes           String?
  drmScheduledAt  DateTime?
  drmCompletedAt  DateTime?
  drmNotes        String?
  approvedBy      String?
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  permitCluster PermitCluster @relation(fields: [permitClusterId], references: [id])
  creator       User          @relation("ApdCreator", fields: [createdBy], references: [id])
  approver      User?         @relation("ApdApprover", fields: [approvedBy], references: [id])
  revisions     ApdRevision[]
  abd           Abd?

