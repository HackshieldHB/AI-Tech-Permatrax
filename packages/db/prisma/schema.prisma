enum ApdStatus {
  DRAFT
  SUBMITTED_FOR_DRM
  DRM_IN_REVIEW
  REVISION_REQUIRED
  APPROVED
}

model ApdRevision {
  id        String   @id @default(cuid())
  apdId     String
  version   Int
  notes     String
  gisData   Json?
  createdBy String
  createdAt DateTime @default(now())

  apd     Apd  @relation(fields: [apdId], references: [id], onDelete: Cascade)
  creator User @relation("ApdRevisionCreator", fields: [createdBy], references: [id])
}

model Abd {
  id               String    @id @default(cuid())
  apdId            String    @unique
  createdBy        String
  version          Int       @default(1)
  status           AbdStatus @default(DRAFT)
  gisRouteData     Json?
  fileUrl          String?
  submittedToIspAt DateTime?
  ispFeedback      String?
  approvedByIspAt  DateTime?
  approvedBy       String?
  rejectionReason  String?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  apd       Apd                @relation(fields: [apdId], references: [id])
  creator   User               @relation("AbdCreator", fields: [createdBy], references: [id])
  approver  User?              @relation("AbdApprover", fields: [approvedBy], references: [id])
  revisions AbdRevision[]
