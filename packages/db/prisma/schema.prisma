generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum ProjectStatus {
  PERMIT
  SURVEY
  DESIGN
  IMPLEMENTATION
  ATP
  CLOSING
}

model Project {
  id               String        @id @default(uuid())
  projectCode      String        @unique
  namaProyek       String
  regionalArea     String
  lokasiProyek     String
  noPO             String
  namaPelaksana    String
  tanggalPerjanjian DateTime
  status           ProjectStatus

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  homepasses       Homepass[]
  documents        Document[]
  requests         Request[]
  activityLogs     ActivityLog[]
  networkDesigns   NetworkDesign[]
}

// ── Network design (GIS FTTH topology persistence) ─────────────────────────
// Phase 2 will use SPLITTER, POLE, SPLICE, CONNECTOR nodes and DROP edges.

enum NodeType {
  OLT
  ODC
  ODP
  SPLITTER
  POLE
  SPLICE
  CONNECTOR
}

enum EdgeType {
  FEEDER
  DISTRIBUTION
  DROP
}

enum NodeOrigin {
  AUTO
  MANUAL
  MODIFIED
}

enum DesignStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  ARCHIVED
}

model NetworkDesign {
  id           String       @id @default(cuid())
  projectId    String
  project      Project      @relation(fields: [projectId], references: [id])
  calcInputs   Json
  baseTopology Json
  sketchTopology Json? @default("{}")
  status       DesignStatus @default(DRAFT)
  version      Int          @default(1)
  createdBy    String
  creator      User         @relation(fields: [createdBy], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  nodes        NetworkNode[]
  edges        NetworkEdge[]

  @@index([projectId])
}

model NetworkNode {
  id         String        @id @default(cuid())
  designId   String
  design     NetworkDesign @relation(fields: [designId], references: [id], onDelete: Cascade)
  type       NodeType
  origin     NodeOrigin
  geom       Unsupported("geometry(Point, 4326)")
  properties Json
  createdAt  DateTime      @default(now())
  fromEdges  NetworkEdge[] @relation("FromNode")
  toEdges    NetworkEdge[] @relation("ToNode")

  @@index([designId])
  @@index([geom], type: Gist)
}

// TODO(design-mode-phase-2): When implementing node deletion, the service must
// delete or reassign edges referencing the node BEFORE deleting the node itself,
// in the same transaction. fromNodeId/toNodeId use ON DELETE RESTRICT to prevent
// silent edge orphaning. See DesignService.deleteNode() (Phase 2).

model NetworkEdge {
  id         String        @id @default(cuid())
  designId   String
  design     NetworkDesign @relation(fields: [designId], references: [id], onDelete: Cascade)
  fromNodeId String
  toNodeId   String
  type       EdgeType
  origin     NodeOrigin
  geom       Unsupported("geometry(LineString, 4326)")
  properties Json
  fromNode   NetworkNode   @relation("FromNode", fields: [fromNodeId], references: [id])
  toNode     NetworkNode   @relation("ToNode", fields: [toNodeId], references: [id])

  @@index([designId])
}

model Homepass {
  id        BigInt  @id @default(autoincrement())
  projectId String
  project   Project @relation(fields: [projectId], references: [id])
  clusterId String
  status    String
  geom      Unsupported("geometry(Point, 4326)")

  @@index([geom], type: Gist)
}

enum DocumentType {
  BAST
  BAUT
  BACT
  ATP_FINDING
}

enum DocumentStatus {
  DRAFT
  GENERATED
  SIGNED
  ARCHIVED
}

model Document {
  id             String         @id @default(uuid())
  type           DocumentType
  projectId      String
  project        Project        @relation(fields: [projectId], references: [id])
  documentNumber String         @unique
  versionNumber  Int
  status         DocumentStatus
  fileUrl        String?
  metadata       Json?
}

enum RequestType {
  PERMIT_APPROVAL
  DESIGN_APPROVAL
  ATP_APPROVAL
  DOCUMENT_SIGN
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SlaStatus {
  SAFE
  WARNING
  BREACHED
}

model Request {
  id              String        @id @default(uuid())
  type            RequestType
  projectId       String
  project         Project       @relation(fields: [projectId], references: [id])
  status          RequestStatus
  requestedBy     String
  assignedToRole  String
  currentApprover String
  slaDeadline     DateTime
  slaStatus       SlaStatus
}

model ActivityLog {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  action      String
  performedBy String
  metadata    Json?
  timestamp   DateTime @default(now())
}

enum Role {
  SURVEYOR_FTTH
  SURVEYOR_FTTB
  SURVEYOR_FTTT
  PM_FTTH
  PM_FTTB
  PM_FTTT
  PM_SENIOR
  DESIGNER // FIX Issue 10: dedicated design-team role for HLD/LLD uploads
  ADMIN
  ADMIN_STOCK
  FINANCE
  GENERAL_MANAGER
  MARKETING
  MARKETING_HEAD
  OPERATIONAL_MANAGER
  PURCHASING // Phase 3: procurement / supplier pricing
  MAP_VIEWER  // Read-only GIS map access (e.g. JLM external users)
}

enum FiberType {
  FTTH
  FTTB
  FTTT
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  password     String     // Hashed
  role         Role       @default(SURVEYOR_FTTH)
  fiberType    FiberType?
  signatureUrl String?
  avatarUrl    String?
  phone        String?
  address      String?
  isActive     Boolean    @default(true)
  lastLoginAt  DateTime?
  createdBy    String?
  refreshToken String?    // stored as bcrypt hash, NOT plain
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  creator        User?    @relation("UserCreatedBy", fields: [createdBy], references: [id])
  createdUsers   User[]   @relation("UserCreatedBy")

  // Phase 2 relations
  importedCleanLists   CleanList[]      @relation("CleanListImporter")
  createdIspCustomers  IspCustomer[]    @relation("IspCustomerCreator")
  visitRequests        VisitRequest[]   @relation("VisitRequester")
  assignedVisits       VisitRequest[]   @relation("VisitPM")
  generatedBaOpens     BaOpen[]         @relation("BaOpenGenerator")
  visitApprovalLogs    VisitApprovalLog[] @relation("ApprovalActor")

  // NEW: Phase 5 — permit pipeline relations
  permitClustersAsPM     PermitCluster[]    @relation("PermitPM")
  createdApds            Apd[]              @relation("ApdCreator")
  approvedApds           Apd[]              @relation("ApdApprover")
  apdRevisions           ApdRevision[]      @relation("ApdRevisionCreator")
  createdAbds            Abd[]              @relation("AbdCreator")
  approvedAbds           Abd[]              @relation("AbdApprover")
  abdRevisions           AbdRevision[]      @relation("AbdRevisionCreator")
  uploadedDiagrams       TechnicalDiagram[] @relation("DiagramUploader")
  conductedSocializations Socialization[]   @relation("SocializationConductor")
  createdCompensations   Compensation[]     @relation("CompensationCreator")
  negotiationLogs        NegotiationLog[]   @relation("NegotiationRecorder")
  createdBaks            Bak[]              @relation("BakCreator")
  approvedBaks           Bak[]              @relation("BakApprover")
  validatedSignatures    SignatureRecord[]  @relation("SignatureValidator")
  conductedScoms         Scom[]             @relation("ScomConductor")
  createdScoms           Scom[]             @relation("ScomCreator")
  validatedBakps         Bakp[]             @relation("BakpValidator")
  compiledBakps          Bakp[]             @relation("BakpCompiler")

  // NEW: Phase 3 relations
  createdStockItems    StockItem[]        @relation("StockItemCreator")
  stockLogs            StockLog[]         @relation("StockLogActor")
  createdOrders        Order[]            @relation("OrderCreator")
  generatedSuratJalan  SuratJalan[]       @relation("SuratJalanGenerator")
  confirmedSuratJalan  SuratJalan[]       @relation("SuratJalanConfirmer")
  purchaseRequests     PurchaseRequest[]  @relation("PRRequester")
  processedPRs         PurchaseRequest[]  @relation("PRProcessor")
  cashOpRequests       CashOperationRequest[] @relation("CashOpRequester")
  cashOpApprovals      CashOpApprovalStep[]   @relation("CashOpApprover")
  cashOpAttachments    CashOpAttachment[]     @relation("CashOpUploader")
  cashOpRealisasiSteps CashOpRealisasiStep[]  @relation("CashOpRealisasiApprover")

  updatedFeatureFlags  FeatureFlag[]      @relation("FeatureFlagUpdater")

  // NEW: full permit lifecycle v2 — survey → SIP → HLD/LLD → finance
  surveyDataConducted   SurveyData[]           @relation("SurveyDataConductor")
  generatedSips         Sip[]                  @relation("SipGenerator")
  createdHlds           Hld[]                  @relation("HldCreator")
  hldRevisions          HldRevision[]          @relation("HldRevisionCreator")
  createdLlds           Lld[]                  @relation("LldCreator")
  lldRevisions          LldRevision[]          @relation("LldRevisionCreator")
  prBrRecords           PrBrRecord[]           @relation("PrBrCreator")
  contracts             ContractRecord[]       @relation("ContractCreator")
  createdSkomBudgets    SkomBudget[]           @relation("SkomCreator")
  approvedSkomBudgets   SkomBudget[]           @relation("SkomApprover")
  disbursementRecords   DisbursementRecord[]   @relation("DisbursementRecorder")
  compiledClaims        ClaimPackage[]         @relation("ClaimCompiler")
  generatedInvoices     InvoicePackage[]       @relation("InvoiceGenerator")
  submittedDocPackages  SurveyorDocPackage[]   @relation("DocPackageSubmitter") // NEW: surveyor doc package submitter
  pmReviewedDocPackages SurveyorDocPackage[]   @relation("DocPackagePmReviewer") // NEW: PM reviewer relation
  adminReviewedDocPackages SurveyorDocPackage[] @relation("DocPackageAdminReviewer") // NEW: Admin reviewer relation
  updatedIspConfigs     IspEmailConfig[]       @relation("IspEmailUpdater") // NEW: ISP email config updater
  uploadedEvidences     SurveyEvidence[]       @relation("SurveyEvidenceUploader") // NEW: survey evidence uploader relation
  notifications         Notification[]         @relation("UserNotifications") // FIX: in-app notification inbox
  gisLayers             GisLayer[]             @relation("GisUploader") // FIX: KMZ / GIS layer uploads

  // Finance dashboard — budget projects (separate from legacy Project model)
  financeProjectsCreated     FinanceProject[] @relation("FinanceProjectCreatedBy")
  financeProjectsUpdated     FinanceProject[] @relation("FinanceProjectUpdatedBy")
  budgetLedgerEntriesCreated BudgetLedger[]   @relation("BudgetLedgerCreator")
  budgetTransfersSubmitted   BudgetTransfer[] @relation("BudgetTransferSubmittedBy")
  budgetTransfersDecided     BudgetTransfer[] @relation("BudgetTransferDecidedBy")

  // Phase 3: procurement
  suppliersCreated            Supplier[]         @relation("SupplierCreatedBy")
  supplierInvoicesUploaded    SupplierInvoice[]  @relation("SupplierInvoiceUploadedBy")
  supplierInvoicesApproved    SupplierInvoice[]  @relation("SupplierInvoiceApprovedBy")
  stockOutsRequested         StockOut[]         @relation("StockOutRequestedBy")
  stockOutsFulfilled         StockOut[]         @relation("StockOutFulfilledBy")
  stockOutsAdminApproved     StockOut[]         @relation("StockOutAdminApprover")
  stockOutsPMConfirmed       StockOut[]         @relation("StockOutPMConfirmer")
  stockOutsFinanceApproved   StockOut[]         @relation("StockOutFinanceApprover")
  ordersPurchasingSubmitted   Order[]            @relation("OrderPurchasingSubmittedBy")
  ordersCancelled            Order[]            @relation("OrderCancelledBy")
  ordersPoEmailSent           Order[]            @relation("OrderPoEmailSentBy")

  networkDesignsCreated NetworkDesign[]

  // FTTT back-relations
  ftttProjectsAsPM      FtttProject[]      @relation("FtttProjectPM")
  ftttSurveyUploads     FtttSurveyUpload[] @relation("FtttSurveyUploader")
  ftttDrmUploads        FtttDrmDocument[]  @relation("FtttDrmUploader")
  ftttSanggahs          FtttSanggah[]      @relation("FtttSanggahSubmitter")
  ftttJaminans          FtttJaminan[]             @relation("FtttJaminanUploader")
  ftttDocuments         FtttDocument[]            @relation("FtttDocUploader")
  ftttImplementationLogs FtttImplementationLog[]  @relation("FtttImplLogUploader")
  ftttReconDocs          FtttReconDoc[]           @relation("FtttReconDocUploader")
  ftttClosingLogs        FtttClosingLog[]         @relation("FtttClosingLogUploader")
  ftttSpans              FtttSpan[]               @relation("FtttSpanCreator")
  ftttSpanLogs           FtttSpanLog[]            @relation("FtttSpanLogUploader")
  ftttMaintConfirmations FtttProject[]            @relation("FtttMaintConfirmer")
}

// Phase 4 — GM-controlled feature visibility per role
model FeatureFlag {
  id          String   @id @default(cuid())
  featureKey  String   @unique
  roles       String[]
  isEnabled   Boolean  @default(true)
  description String?
  updatedBy   String
  updatedAt   DateTime @updatedAt

  updater     User     @relation("FeatureFlagUpdater", fields: [updatedBy], references: [id])

  @@index([featureKey])
}

model MapDrawing {
  id          String   @id @default(cuid())
  projectId   String?
  geojson     Json
  color       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// FIX: GIS — KMZ layers converted to GeoJSON for MapLibre
model GisLayer {
  id         String   @id @default(cuid())
  name       String
  fileUrl    String
  geoJson    Json
  color      String   @default("#FF6B00")
  isVisible  Boolean  @default(true)
  uploadedBy String
  uploader   User     @relation("GisUploader", fields: [uploadedBy], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([uploadedBy])
}

model DeploymentCluster {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  category        String   
  targetHp        Int      @default(0)
  status          String   @default("PLANNING") 
  proposedBudget  Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  surveyReport    SurveyReport?
  legalAttachments LegalAttachment[]
  documentRequest DocumentRequest?
}

model LegalAttachment {
  id           String   @id @default(cuid())
  clusterId    String
  cluster      DeploymentCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  documentType String   // "KTP", "SK_RT", "PKS", "SIGNED_BAKP"
  fileUrl      String
  uploadedBy   String
  createdAt    DateTime @default(now())
}

model SurveyReport {
  id              String   @id @default(cuid())
  clusterId       String   @unique
  cluster         DeploymentCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  estimatedHP     Int      
  estimatedPoles  Int      
  fieldNotes      String?  @db.Text
  latitude        Float?
  longitude       Float?
  surveyedBy      String   
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}


model DocumentRequest {
  id            String   @id @default(cuid())
  clusterId     String   @unique
  cluster       DeploymentCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  documentType  String   // "BA_SURVEY", "BAK", "BAKP", "INVOICE"
  currentStage  String   // "PENDING_ADMIN", "PENDING_FS", "PENDING_ACK", "PENDING_MANAGER", "READY_INVOICE"
  status        String   @default("IN_PROGRESS") // IN_PROGRESS, APPROVED, REJECTED
  requestedBy   String   // User ID
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  approvalLogs  ApprovalLog[]
}

model ApprovalLog {
  id                String   @id @default(cuid())
  documentRequestId String
  documentRequest   DocumentRequest @relation(fields: [documentRequestId], references: [id], onDelete: Cascade)
  actionBy          String   // User ID or Role
  action            String   // "SUBMITTED", "APPROVED", "REJECTED", "ACKNOWLEDGED"
  stage             String   // The stage this action occurred in
  notes             String?  // Reason for rejection/approval
  createdAt         DateTime @default(now())
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  userRole  String?
  title     String
  message   String
  type      String    @default("GENERAL")
  link      String?
  entityId  String?
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userRole, isRead])
  @@index([createdAt])
}

