// ─────────────────────────────────────────────
// NEW: CASH OPERATION REQUEST
// ─────────────────────────────────────────────
model CashOperationRequest {
  id              String              @id @default(cuid())
  requestNumber   String              @unique
  type            CashOperationType
  requestedBy     String
  description     String
  amount          Decimal             @db.Decimal(15, 2)
  currency        String              @default("IDR")
  category        String?
  projectRef      String?
  status          CashOpStatus        @default(DRAFT)
  currentStepRole String?
  slaDeadline     DateTime?
  slaBreached     Boolean             @default(false)
  rejectionReason String?
  financeNotes    String?
  disbursedAt     DateTime?
  disbursedAmount Decimal?            @db.Decimal(15, 2)

  // FIX: structured line items
  lineItems       Json?
  totalAmount     Decimal?            @default(0)
  photoUrls       Json?
  fileUrl         String?

  // FIX: approval chain tracking (full chain incl. submitter at index 0 — matches frontend)
  approvalChain       Json?
  approvalHistory     Json?
  currentApproverRole String?
  currentStep         Int               @default(0)
  totalSteps          Int               @default(0)

  // Cash Advance Stage 1 — usage period (optional until CA flow populated)
  periodeFrom DateTime?
  periodeTo   DateTime?

  /// Final approved jasa amount after Stage 1 chain; set when status reaches APPROVED (both CA and reimbursement).
  finalApprovedAmount Decimal? @db.Decimal(18, 2)

  // Cash Advance Stage 2 — realization (null until CA enters realization flow)
  realisasiSubmittedAt     DateTime?
  realisasiTotal           Decimal?         @db.Decimal(18, 2)
  realisasiStatus          RealisasiStatus?
  realisasiCurrentStepRole String?
  realisasiRejectionReason String?
  realisasiCompletedAt     DateTime?
  
  // Issue C: Requester's bank account number for CA form
  nomorRekeningPengaju     String?
  
  // Issue D: Finance-level realisasi rejection and bank account
  realisasiNomorRekeningFinance String?
  realisasiRejectedAt      DateTime?
  realisasiRejectedById    String?
  realisasiRejectedReason  String?

  // GM and Finance signature fields for realisasi approval
  gmSignatureUrl         String?
  gmApprovedAt             DateTime?
  gmApprovedById           String?
  financeSignatureUrl      String?
  financeApprovedAt        DateTime?
  financeApprovedById      String?
  financeNominalDisetujui  Decimal?
  
  approvedAt               DateTime?

  financeProjectId String?
  financeProject   FinanceProject? @relation(fields: [financeProjectId], references: [id], onDelete: SetNull)

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  requester       User                @relation("CashOpRequester", fields: [requestedBy], references: [id])
  attachments     CashOpAttachment[]
  approvalSteps   CashOpApprovalStep[]
  realisasiItems  CashOpRealisasiItem[]
  realisasiSteps  CashOpRealisasiStep[]

  @@index([status])
  @@index([requestedBy])
  @@index([type])
  @@index([requestNumber])
  @@index([financeProjectId])
  @@index([realisasiStatus])
  @@index([periodeTo])
}

enum CashOperationType {
  CASH_ADVANCE
  REIMBURSEMENT
}

enum CashOpStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  DISBURSED
  REJECTED
  CANCELLED
  REALISASI_IN_PROGRESS
  REALISASI_PENDING_PM
  REALISASI_REJECTED_BY_PM
  REALISASI_PENDING_OPS
  REALISASI_PENDING_MARKETING_HEAD
  REALISASI_REJECTED_BY_OPS
  REALISASI_REJECTED_BY_MARKETING_HEAD
  REALISASI_PENDING_GM
  REALISASI_REJECTED_BY_GM
  REALISASI_PENDING_FINANCE
  REALISASI_REJECTED_BY_FINANCE
  REALISASI_DONE
  DONE
}

enum RealisasiStatus {
  DRAFT
  PENDING_PM_REVIEW
  PENDING_OPS_REVIEW
  PENDING_GM_REVIEW
  PENDING_FINANCE_REVIEW
  PENDING_MARKETING_HEAD_REVIEW
  REJECTED
  DONE
}

// ─────────────────────────────────────────────
// NEW: APPROVAL STEP — each step in the chain
// ─────────────────────────────────────────────
model CashOpApprovalStep {
  id              String               @id @default(cuid())
  requestId       String
  stepOrder       Int
  approverRole    String
  approverId      String?
  status          StepStatus           @default(PENDING)
  approvedAmount  Decimal?             @db.Decimal(18, 2)
  notes           String?
  decidedAt       DateTime?
  createdAt       DateTime             @default(now())

  request         CashOperationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  approver        User?                @relation("CashOpApprover", fields: [approverId], references: [id])

  @@index([requestId])
  @@index([approverRole])
  @@index([status])
}

model CashOpRealisasiItem {
  id              String   @id @default(cuid())
  cashOpRequestId String
  itemNumber      Int
  description     String
  paymentDate     DateTime
  amount          Decimal  @db.Decimal(18, 2)
  // Issue D: Finance override amount
  finalAmount     Decimal? @db.Decimal(15, 2)
  photoUrl        String?
  createdAt       DateTime @default(now())

  cashOpRequest CashOperationRequest @relation(fields: [cashOpRequestId], references: [id], onDelete: Cascade)

  @@index([cashOpRequestId, itemNumber])
}

model CashOpRealisasiStep {
  id              String     @id @default(cuid())
  cashOpRequestId String
  stepOrder       Int
  approverRole    String
  approverId      String?
  status          StepStatus @default(PENDING)
  approvedAt      DateTime?
  rejectionReason      String?
  notes                String?
  hasilCheckingFinance String?
  createdAt            DateTime   @default(now())

  cashOpRequest CashOperationRequest @relation(fields: [cashOpRequestId], references: [id], onDelete: Cascade)
  approver      User?                @relation("CashOpRealisasiApprover", fields: [approverId], references: [id])

  @@index([cashOpRequestId])
}

enum StepStatus {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

// ─────────────────────────────────────────────
// NEW: ATTACHMENT
// ─────────────────────────────────────────────
model CashOpAttachment {
  id          String               @id @default(cuid())
  requestId   String
  fileName    String
  fileUrl     String
  fileSize    Int?
  mimeType    String?
  uploadedBy  String
  createdAt   DateTime             @default(now())

  request     CashOperationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  uploader    User                 @relation("CashOpUploader", fields: [uploadedBy], references: [id])

  @@index([requestId])
}

// ─────────────────────────────────────────────
// Finance Dashboard — budget projects & ledger (separate from legacy Project)
// ─────────────────────────────────────────────

enum FinanceProjectStatus {
  ACTIVE
  CLOSED
  ARCHIVED
}

enum BudgetLedgerCategory {
  MATERIAL
  JASA
}

enum BudgetLedgerEntryType {
  BUDGET_INIT
  BUDGET_ADJUSTMENT
  DEDUCT_MATERIAL
  DEDUCT_JASA
  REFUND_MATERIAL
  REFUND_JASA
  TRANSFER_OUT
  TRANSFER_IN
}

enum BudgetLedgerSourceType {
  ORDER
  CASH_OP
  MANUAL_ADJUSTMENT
  TRANSFER
}

enum BudgetTransferStatus {
  PENDING_GM_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
}

model FinanceProject {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?

  totalBudget    Decimal  @db.Decimal(18, 2)
  materialBudget Decimal? @db.Decimal(18, 2)
  jasaBudget     Decimal? @db.Decimal(18, 2)

  materialSpent Decimal @default(0) @db.Decimal(18, 2)
  jasaSpent     Decimal @default(0) @db.Decimal(18, 2)

  isOverbudget              Boolean @default(false)
  isDefaultUncategorized    Boolean @default(false)

  endDate DateTime?

  status FinanceProjectStatus @default(ACTIVE)

  createdById String
  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy User  @relation("FinanceProjectCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("FinanceProjectUpdatedBy", fields: [updatedById], references: [id])

  ledgerEntries           BudgetLedger[]
  orders                  Order[]
  cashOperationRequests   CashOperationRequest[]
  transfersOut            BudgetTransfer[] @relation("TransferSourceProject")
  transfersIn             BudgetTransfer[] @relation("TransferTargetProject")
  plannings               FinanceProjectPlanning[]

  @@index([status])
  @@index([isDefaultUncategorized])
  @@index([code])
}

model FinanceProjectPlanning {
  id               String         @id @default(cuid())
  financeProjectId String
  financeProject   FinanceProject @relation(fields: [financeProjectId], references: [id], onDelete: Cascade)
  month            Int            // 1–12
  year             Int            // e.g. 2024
  plannedAmount    Decimal        @db.Decimal(15, 2)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([financeProjectId, month, year])
}

model BudgetLedger {
  id               String @id @default(cuid())
  financeProjectId String

  entryType BudgetLedgerEntryType
  category  BudgetLedgerCategory?

  /// Positive magnitude; direction implied by entryType (deduct vs refund vs transfer).
  amount Decimal @db.Decimal(18, 2)

  sourceType BudgetLedgerSourceType?
  sourceId   String?

  budgetTransferId String?

  notes    String?
  metadata Json?

  createdById String?
  createdAt   DateTime @default(now())

  financeProject FinanceProject @relation(fields: [financeProjectId], references: [id], onDelete: Restrict)
  budgetTransfer BudgetTransfer? @relation(fields: [budgetTransferId], references: [id], onDelete: SetNull)
  createdBy      User?           @relation("BudgetLedgerCreator", fields: [createdById], references: [id])

  /// DB partial unique indexes (see migration `budget_ledger_idempotency_constraint`):
  /// - Main: (sourceType, sourceId, entryType) for deduct/refund rows without metadata.partialRefundType
  /// - Partial refund: (sourceType, sourceId, entryType, metadata->>'partialRefundType') for tagged REFUND_JASA

  @@index([financeProjectId, createdAt])
  @@index([sourceType, sourceId])
  @@index([budgetTransferId])
}

model BudgetTransfer {
  id String @id @default(cuid())

  sourceFinanceProjectId String
  targetFinanceProjectId String

  sourceCategory BudgetLedgerCategory
  targetCategory BudgetLedgerCategory

  amount Decimal @db.Decimal(18, 2)
  reason String

  status          BudgetTransferStatus @default(PENDING_GM_APPROVAL)
  submittedById   String
  decidedById     String?
  decidedAt       DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sourceProject FinanceProject @relation("TransferSourceProject", fields: [sourceFinanceProjectId], references: [id], onDelete: Restrict)
  targetProject FinanceProject @relation("TransferTargetProject", fields: [targetFinanceProjectId], references: [id], onDelete: Restrict)
  submittedBy   User           @relation("BudgetTransferSubmittedBy", fields: [submittedById], references: [id])
  decidedBy     User?          @relation("BudgetTransferDecidedBy", fields: [decidedById], references: [id])

  ledgerEntries BudgetLedger[]

  @@index([status])
  @@index([sourceFinanceProjectId])
  @@index([targetFinanceProjectId])
  @@index([submittedById])
}

// ═══════════════════════════════════════════════════════════════════════════
// FTTT PROJECT FLOW — Phase-gated lifecycle for Tower Fiber projects
// 3 companies: Telkom Infra (skips survey), iForte (Sanggah), PST (DRM)
// ═══════════════════════════════════════════════════════════════════════════

enum FtttCompany {
  TELKOM_INFRA
  IFORTE
  PST
}

enum FtttPhase {
  INITIATION
  SURVEY
  PREPARATION
  PROCUREMENT    // PST: PO upload by PM between Preparation and Implementation
  IMPLEMENTATION
  DOCUMENTATION
  RECONCILIATION
  CLOSING
}

enum FtttProjectStatus {
  ACTIVE
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum FtttPhaseStatus {
  LOCKED
  ACTIVE
  COMPLETED
  SKIPPED
}

enum FtttDocType {
  PO_CONTRACT
  SITELIST
  BOQ_TOS
}

enum FtttSanggahStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
}

enum FtttJaminanType {
  JAMINAN_UANG_MUKA
  JAMINAN_PELAKSANAAN
}

enum FtttDocumentType {
  // Shared
  ATP
  EVIDENCE
  BAUT
  BAUT_REKONSILIASI
  BACT               // Berita Acara Commissioning Test — TI + PST Documentation & Acceptance
  // Telkom Infra — Documentation & Acceptance upload docs (legacy, kept for backward compat)
  KONTRAK
  PO
  AMANDEMEN_1
  DOK_PERUBAHAN_WAKTU
  // Legacy (kept for backward compat, not shown in UI)
  SUPPORTING
}

enum FtttApprovalStatus {
  PENDING_PM
  PENDING_ADMIN
  APPROVED
  REJECTED
}

// JLM: PST implementation type — Galian uses span-based daily log; KU uses existing flow
enum FtttImplementationType {
  GALIAN
  KU
}

model FtttProject {
  id             String            @id @default(cuid())
  cleanListId    String?
  ftttCompany    FtttCompany
  triggerDocUrl  String
  triggerDocType FtttDocType
  currentPhase   FtttPhase         @default(INITIATION)
  status         FtttProjectStatus @default(ACTIVE)
  pmId           String
  projectName    String?
  notes          String?
  // JLM: PST Implementation type (Galian → span-based; KU → existing). Null for TI/iFORTE.
  implementationType FtttImplementationType?
  // JLM: Project Closing maintenance confirmation + reminder (TI + PST)
  maintenanceEndDate        DateTime?
  maintenanceConfirmedAt    DateTime?
  maintenanceConfirmedById  String?
  lastMaintReminderAt       DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  cleanList       CleanList?          @relation("FtttProjectCleanList", fields: [cleanListId], references: [id])
  pm              User                @relation("FtttProjectPM", fields: [pmId], references: [id])
  maintenanceConfirmedBy User?         @relation("FtttMaintConfirmer", fields: [maintenanceConfirmedById], references: [id])

  phaseProgresses FtttPhaseProgress[]
  surveyUploads      FtttSurveyUpload[]
  drmDocuments       FtttDrmDocument[]
  sanggahs           FtttSanggah[]
  jaminans           FtttJaminan[]
  documents          FtttDocument[]
  implementationLogs FtttImplementationLog[]
  reconDocs          FtttReconDoc[]
  closingLogs        FtttClosingLog[]
  spans              FtttSpan[]

  @@index([ftttCompany])
  @@index([currentPhase])
  @@index([pmId])
  @@index([status])
}

model FtttPhaseProgress {
  id            String          @id @default(cuid())
  projectId     String
  project       FtttProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase         FtttPhase
  status        FtttPhaseStatus @default(LOCKED)
  unlockedAt    DateTime?
  completedAt   DateTime?
  completedById String?
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([projectId, phase])
}

model FtttSurveyUpload {
  id           String      @id @default(cuid())
  projectId    String
  project      FtttProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User        @relation("FtttSurveyUploader", fields: [uploadedById], references: [id])
  fileUrl      String
  fileType     String      // photo | supporting_file | survey_evidence | operational_notes
  caption      String?
  createdAt    DateTime    @default(now())

  @@index([projectId])
}

model FtttDrmDocument {
  id           String      @id @default(cuid())
  projectId    String
  project      FtttProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  docType      String      // BOQ_INITIAL | TOS_INITIAL | DRM_RESULT | ACTUAL
  version      Int         @default(1)
  fileUrl      String
  notes        String?
  uploadedById String
  uploadedBy   User        @relation("FtttDrmUploader", fields: [uploadedById], references: [id])
  uploadedAt   DateTime    @default(now())

  @@index([projectId, docType])
}

model FtttSanggah {
  id            String            @id @default(cuid())
  projectId     String
  project       FtttProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  attemptNumber Int
  reason        String
  fileUrl       String?
  status        FtttSanggahStatus @default(SUBMITTED)
  submittedById String
  submittedBy   User              @relation("FtttSanggahSubmitter", fields: [submittedById], references: [id])
  submittedAt   DateTime          @default(now())
  resolvedAt    DateTime?
  resolvedById  String?
  responseNotes String?

  @@unique([projectId, attemptNumber])
  @@index([projectId])
}

model FtttJaminan {
  id           String          @id @default(cuid())
  projectId    String
  project      FtttProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  jaminanType  FtttJaminanType
  amount       Decimal?        @db.Decimal(15, 2)
  issuer       String?
  issueDate    DateTime?
  expiryDate   DateTime?
  fileUrl      String?
  notes        String?
  uploadedById String
  uploadedBy   User            @relation("FtttJaminanUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime        @default(now())

  @@index([projectId])
}

model FtttDocument {
  id              String             @id @default(cuid())
  projectId       String
  project         FtttProject        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  docType         FtttDocumentType
  fileUrl         String?          // nullable: form-generated docs don't have a physical file
  formContent     String?          // JSON: form fields for Generate Form mode docs
  notes           String?
  approvalStatus  FtttApprovalStatus @default(PENDING_PM)
  uploadedById    String
  uploadedBy      User               @relation("FtttDocUploader", fields: [uploadedById], references: [id])
  pmApprovedById    String?
  pmApprovedAt      DateTime?
  adminApprovedById String?
  adminApprovedAt   DateTime?
  rejectionNotes    String?  // mandatory reason filled by PM/Admin when rejecting
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([projectId])
}

// Reconciliation & Billing phase documents
model FtttReconDoc {
  id              String             @id @default(cuid())
  projectId       String
  project         FtttProject        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  docKey          String             // e.g. 'BAPP', 'BAST_BAPWPP', 'GOOD_RECEIPT' etc.
  fileUrl         String?
  formContent     String?            // JSON: form fields for Generate Form mode docs
  notes           String?
  approvalStatus  FtttApprovalStatus @default(PENDING_PM)
  uploadedById    String
  uploadedBy      User               @relation("FtttReconDocUploader", fields: [uploadedById], references: [id])
  pmApprovedById    String?
  pmApprovedAt      DateTime?
  adminApprovedById String?
  adminApprovedAt   DateTime?
  rejectionNotes    String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([projectId, docKey])
  @@index([projectId])
}

enum FtttImplLogType {
  PHOTO
  MONITORING_DOC
  NOTE
}

model FtttImplementationLog {
  id           String           @id @default(cuid())
  projectId    String
  project      FtttProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User             @relation("FtttImplLogUploader", fields: [uploadedById], references: [id])
  logType      FtttImplLogType
  fileUrl      String?
  caption      String?
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([projectId])
}

// ─── Span-based Daily Implementation Log (Telkom Infra only) ─────────────────
// Each span groups daily upload logs by category folder for chronological audit trail

enum FtttSpanLogCategory {
  GALIAN
  VIDEO_GALIAN
  PERBAIKAN
  HANDHOLE
  JEMBATAN
  JOIN_TERMINASI
  MARKING_POS
}

model FtttSpan {
  id          String      @id @default(cuid())
  projectId   String
  project     FtttProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  spanNumber  String
  createdById String
  createdBy   User        @relation("FtttSpanCreator", fields: [createdById], references: [id])
  createdAt   DateTime    @default(now())

  spanLogs    FtttSpanLog[]

  @@unique([projectId, spanNumber])
  @@index([projectId])
}

model FtttSpanLog {
  id           String              @id @default(cuid())
  spanId       String
  span         FtttSpan            @relation(fields: [spanId], references: [id], onDelete: Cascade)
  projectId    String
  category     FtttSpanLogCategory
  fileUrl      String
  caption      String?
  uploadedById String
  uploadedBy   User                @relation("FtttSpanLogUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime            @default(now())

  @@index([spanId])
  @@index([projectId])
}

// Project Closing phase — BAST II, evidence photos, closing notes
enum FtttClosingLogType {
  BAST_II    // formal handover doc — requires PM approval
  EVIDENCE   // serah terima photo evidence
  NOTE       // closing notes / catatan
}

model FtttClosingLog {
  id              String              @id @default(cuid())
  projectId       String
  project         FtttProject         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  logType         FtttClosingLogType
  fileUrl         String?
  formContent     String?            // JSON: form fields for Generate Form mode docs
  caption         String?
  notes           String?
  approvalStatus  FtttApprovalStatus? // null for EVIDENCE/NOTE; PENDING_PM/APPROVED/REJECTED for BAST_II
  rejectionNotes  String?
  uploadedById    String
  uploadedBy      User                @relation("FtttClosingLogUploader", fields: [uploadedById], references: [id])
  pmApprovedById  String?
  pmApprovedAt    DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([projectId])
}
