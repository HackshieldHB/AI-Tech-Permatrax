// ─────────────────────────────────────────────
// FIX PR/BR→PO flow: unified workflow state per cluster
// Phases: PR_BR_ISSUANCE (upload PR/BR → Admin review) →
//         CONTRACT_MANAGEMENT (Admin creates PO → Ops review) → SKOM_BUDGET
// ─────────────────────────────────────────────
model PrBrWorkflow {
  id              String              @id @default(cuid())
  permitClusterId String              @unique // FIX: one workflow per cluster
  permitCluster   PermitCluster       @relation(fields: [permitClusterId], references: [id], onDelete: Cascade)

  // FIX: PR/BR documents from ISP
  prFileUrl       String?
  brFileUrl       String?
  prBrNotes       String?

  // FIX: PO document created by Admin after PR/BR approved
  poFileUrl       String?
  poNotes         String?

  status          PrBrWorkflowStatus  @default(PENDING_UPLOAD) // FIX: state machine for the combined flow

  // FIX: audit trail fields for each handover in the chain
  uploadedBy      String?
  uploadedAt      DateTime?
  adminReviewedBy String?
  adminReviewedAt DateTime?
  adminNotes      String?
  opsApprovedBy   String?
  opsApprovedAt   DateTime?
  opsNotes        String?

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([status])
}

enum PrBrWorkflowStatus {
  PENDING_UPLOAD // FIX: cluster entered PR_BR_ISSUANCE, waiting for PM/Admin to upload PR/BR
  UPLOADED       // FIX: PR/BR uploaded, waiting Admin review
  ADMIN_APPROVED // FIX: Admin approved PR/BR → Admin now creates PO (phase advances to CONTRACT_MANAGEMENT)
  ADMIN_REJECTED // FIX: Admin rejected PR/BR → PM must re-upload (stays in PR_BR_ISSUANCE)
  PO_CREATED     // FIX: Admin uploaded PO → waiting Ops Manager approval
  OPS_APPROVED   // FIX: Ops approved PO → phase advances to SKOM_BUDGET
  OPS_REJECTED   // FIX: Ops rejected PO → Admin must revise (stays in CONTRACT_MANAGEMENT)
}

