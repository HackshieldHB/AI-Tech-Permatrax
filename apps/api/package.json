{
  "name": "@permatrack/api",
  "version": "1.0.0",
  "description": "PermaTrack NestJS Backend",
  "private": true,
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start --entryFile apps/api/src/main",
    "start:dev": "nest start --watch --entryFile apps/api/src/main",
    "start:debug": "nest start --debug --watch --entryFile apps/api/src/main",
    "start:prod": "node dist/apps/api/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "npx jest --passWithNoTests",
    "test:pai": "npx jest src/ai/ai.service.spec.ts --runInBand",
    "test:pai:golden": "npx jest src/ai/ai.service.spec.ts -t \"P0|P1|P2 golden|Round 4|CSM-002|V4|V5|V6|V7|RSN-003|BHV-005\" --runInBand",
    "test:watch": "npx jest --watch",
    "test:cov": "npx jest --coverage",
    "test:e2e": "npx jest --config ./test/jest-e2e.json --passWithNoTests",
    "test:e2e:watch": "npx jest --config ./test/jest-e2e.json --watch"
  },
  "dependencies": {
    "@nestjs/bull": "^10.1.1",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/platform-socket.io": "^10.0.0",
    "@nestjs/swagger": "^7.3.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^10.0.0",
    "@permatrack/db": "workspace:*",
    "@prisma/client": "5.22.0",
    "@sentry/node": "^10.51.0",
    "@sentry/profiling-node": "^10.51.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcrypt": "^5.1.1",
    "bull": "^4.12.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "exceljs": "^4.4.0",
    "helmet": "5.1.0",
    "ioredis": "5.4.1",
    "multer": "2.0.2",
    "nest-winston": "^1.9.4",
    "nestjs-zod": "^3.0.0",
    "nodemailer": "^6.9.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "1.0.0",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.14.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "socket.io": "^4.7.4",
    "winston": "^3.12.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/bull": "^3.15.9",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.0",
    "@types/multer": "1.4.12",
    "@types/node": "^20.3.1",
    "@types/nodemailer": "^6.4.14",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "1.0.38",
    "@types/pdfkit": "^0.13.4",
    "@types/supertest": "^6.0.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.1.3"
  }
}
