# FIX: safe template — copy to apps/api/.env and fill real values
# NEVER commit .env with real secrets (already listed in .gitignore)

# App
PORT=3001
NODE_ENV=development

# FRONTEND_URL — comma-separated list of allowed origins (CORS allowlist in production).
# Must include EVERY origin the browser will load the FE from:
#   - localhost dev:   http://localhost:3000
#   - ngrok static:    https://<your-frontend-static>.ngrok-free.dev
# In development (NODE_ENV !== production) CORS is lenient (any origin allowed),
# but `scripts/apply-ngrok-tunnels.ps1` still rewrites this list on every ngrok boot
# so that flipping NODE_ENV=production works without surprises.
FRONTEND_URL=http://localhost:3000,https://mongoose-enjoyable-yield.ngrok-free.dev

# CORS — production only (comma-separated). When unset, FRONTEND_URL is used as the allowlist.
# Example: CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=

# Database
# Format: postgresql://USER:PASS@HOST:5432/DB?schema=public
#
# PRODUCTION TUNING (recommended for ~100 concurrent users):
# Add query params: ?connection_limit=N&pool_timeout=20
#
# Math: connection_limit × PM2 instances + admin_margin <= postgres max_connections
# Example for 8 PM2 workers + max_connections=200:
#   ...?schema=public&connection_limit=5&pool_timeout=20  → 8 × 5 = 40 app connections
#
# Recommended starting values:
# - Development (single Nest process): connection_limit=10
# - Production VPS 8 cores (PM2 cluster): connection_limit=5 per worker
# - Production with PgBouncer: connection_limit=2 (PgBouncer handles pooling)
#
# Prisma reads connection_limit from this URL automatically (no code change needed).
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/permatrack?schema=public&connection_limit=10&pool_timeout=20

# Redis — JWT blacklist, Socket.IO adapter, cache map, Bull (PDF + mail antrian)
REDIS_URL=redis://localhost:6379

# JWT — MUST be a 64-byte random value in production
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
# Or in PowerShell:
#   $b=New-Object byte[] 64;[Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b);[Convert]::ToBase64String($b)
JWT_SECRET=REPLACE_WITH_64_BYTE_RANDOM_BASE64_SECRET
JWT_EXPIRES_IN=8h
REFRESH_TOKEN_EXPIRES_IN=7d

# Local File Storage (no AWS required)
UPLOAD_DIR=./uploads

# FILE_BASE_URL — public URL prefix the API stamps onto stored-file links it returns
# to the frontend. MUST switch in lockstep with NEXT_PUBLIC_API_URL:
#   - Local dev:  http://localhost:3001/api/files
#   - Ngrok:      https://mongoose-enjoyable-yield.ngrok-free.dev/api/files
# scripts/apply-ngrok-tunnels.ps1 rewrites this automatically when ngrok comes up.
FILE_BASE_URL=http://localhost:3001/api/files

# Sentry — pelacakan error produksi (opsional; kosongkan untuk menonaktifkan)
SENTRY_DSN=

# Email (optional — untuk fitur email ISP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=noreply@permatrax.com

# Procurement email sender
PROCUREMENT_FROM_EMAIL=procurement@permatrack.id
