# ─── Permatrax DEV VPS Environment ───────────────────────────────────────────
# Copy file ini ke .env.local di VPS sebelum build/start
# cp .env.dev-vps .env.local
#
# CRITICAL: BASE_PATH + NEXT_PUBLIC_* must be present at `pnpm build` time.
# Building without BASE_PATH=/Permatrax produces asset URLs at /_next/* (wrong)
# and the app spins forever under https://aitech-ilt.co.id/Permatrax.

# Serve Next.js di bawah /Permatrax (aitech-ilt.co.id/Permatrax)
BASE_PATH=/Permatrax
NEXT_PUBLIC_BASE_PATH=/Permatrax

# Port untuk Permatrax DEV web (hindari konflik dengan website di :3000)
PORT=3002

# Permatrax DEV API (NestJS) — port terpisah dari PROD (:3001)
API_URL=http://localhost:3003

# Browser-facing API / files (baked into Next client bundle at build time)
NEXT_PUBLIC_API_URL=https://aitech-ilt.co.id/Permatrax/api
NEXT_PUBLIC_FILES_URL=https://aitech-ilt.co.id/Permatrax/api/files

# Isi sesuai kebutuhan — sama seperti .env PROD tapi pointing ke DB dev
# DATABASE_URL=
# JWT_SECRET=
# REDIS_URL=
