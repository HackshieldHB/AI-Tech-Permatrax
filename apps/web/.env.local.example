# ─────────────────────────────────────────────────────────────────────────────
#  apps/web/.env.local — frontend public env (Next.js reads this ONCE at start)
#
#  IMPORTANT: Next.js does NOT hot-reload env files. After any change you MUST
#  stop and restart `next dev` (or `pnpm dev`) for the new value to take effect.
#
#  `scripts/apply-ngrok-tunnels.ps1` rewrites this file on every ngrok boot.
# ─────────────────────────────────────────────────────────────────────────────

# Default for local development:
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# When using ngrok with a pinned static domain, switch the line above for:
# NEXT_PUBLIC_API_URL=https://mongoose-enjoyable-yield.ngrok-free.dev/api

# Optional override for the file-server prefix (defaults to <API_URL host>/api/files).
# Keep aligned with backend FILE_BASE_URL if you set it explicitly.
NEXT_PUBLIC_FILES_URL=http://localhost:3001/api/files

NEXT_PUBLIC_APP_NAME=PermaTrax
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-token
NODE_ENV=development

# Sentry — frontend error tracking (optional; public DSN)
NEXT_PUBLIC_SENTRY_DSN=
# Server-side Sentry (SSR / route handlers); may equal backend project
SENTRY_DSN=
